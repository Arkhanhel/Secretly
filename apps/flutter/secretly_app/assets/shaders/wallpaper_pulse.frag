#version 460 core
// wallpaper_pulse.frag — «обои проводят сообщение».
//
// Волна света идёт по СЕТИ ДУДЛОВ: не по прямой, а вдоль линий узора. Поле
// геодезических расстояний запечено заранее (tools/bake_wallpaper_field.py) в
// assets/wallpaper_fx/pattern_field.png: канал R — расстояние от нижнего края
// вдоль линий, канал G — от верхнего. Поэтому фронт огибает дудлы, ветвится на
// перекрёстках и запаздывает в дальних углах.
//
// Направление света = направление общения: исходящее уходит от вас вверх
// (читаем R), входящее стекает сверху к вам (читаем G).
//
// ВОЛН СРАЗУ НЕСКОЛЬКО — до четырёх. Если писать быстро, вторая волна не ждёт
// первую: они идут друг за другом, как и должен выглядеть поток сообщений.
// У каждой своё положение фронта и своё направление, поэтому исходящее и
// входящее могут лететь навстречу.
//
// Шейдер рисует ТОЛЬКО ПРИБАВКУ света. Он накладывается через BlendMode.plus
// поверх уже нарисованных цветных пятен и ДО маски дудлов, поэтому маска сама
// обрезает свечение по линиям, а обои без импульса остаются попиксельно теми
// же, что и раньше (слой просто не рисуется).
#include <flutter/runtime_effect.glsl>

uniform vec2 uSize; // размер прямоугольника отрисовки, в пикселях

// Перевод экранных координат в координаты поля. Считается на стороне Dart той
// же математикой «cover», что и для маски, иначе волна поехала бы относительно
// линий, по которым обязана идти.
uniform vec2 uFieldScale;
uniform vec2 uFieldOffset;

uniform float uCount; // сколько волн активно, 0..4
uniform vec4 uPulse; // положение фронта каждой волны, 0 → 1.35
uniform vec4 uDirTop; // направление каждой: 0 — вверх, 1 — сверху вниз

uniform float uGain; // общая сила эффекта
uniform vec3 uTint; // цвет волны вдали от ядра (ядро всегда белее)

uniform sampler2D uField;

out vec4 fragColor;

/// Вклад одной волны: x — энергия, y — яркость самого фронта.
///
/// [gate] — 0 или 1 вместо ветвления: цикл с границей по uniform'у и
/// динамическая индексация вектора компилируются по-разному на разных
/// бэкендах, а четыре развёрнутых вызова — одинаково везде.
///
/// Назван gate, а не active: `active` в GLSL — ЗАРЕЗЕРВИРОВАННОЕ СЛОВО, и
/// компилятор шейдеров валит на нём всю сборку.
vec2 wave(float d, float pos, float gate) {
  // Возводим умножением, а не pow(): у pow() с отрицательным основанием
  // поведение не определено, а (d - pos) отрицательно перед фронтом.
  float front = (d - pos) * 14.0;
  float band = exp(-front * front);
  // Затухающий след позади фронта — то, что делает волну «прошедшей», а не
  // просто мигнувшей полосой.
  float tail = (d < pos) ? 0.28 * exp(-(pos - d) * 5.5) : 0.0;
  return vec2(gate * (0.85 * band + tail), gate * band);
}

void main() {
  vec2 uv = FlutterFragCoord().xy / uSize;
  vec2 fieldUv = clamp(uv * uFieldScale + uFieldOffset, 0.0, 1.0);
  vec4 field = texture(uField, fieldUv);

  vec2 a = wave(mix(field.r, field.g, uDirTop.x), uPulse.x, step(0.5, uCount));
  vec2 b = wave(mix(field.r, field.g, uDirTop.y), uPulse.y, step(1.5, uCount));
  vec2 c = wave(mix(field.r, field.g, uDirTop.z), uPulse.z, step(2.5, uCount));
  vec2 d = wave(mix(field.r, field.g, uDirTop.w), uPulse.w, step(3.5, uCount));

  // Энергия складывается — свет физически складывается. Потолок нужен, чтобы
  // четыре волны, сошедшиеся в одной точке, не выжигали кадр добела: яркость
  // всего эффекта откалибрована на одну волну.
  float energy = uGain * min(a.x + b.x + c.x + d.x, 1.6);

  // А вот белизна ядра берётся по МАКСИМУМУ, а не суммой: ядро — признак «здесь
  // проходит фронт», и от того, что рядом идёт вторая волна, оно не должно
  // становиться белее.
  float core = max(max(a.y, b.y), max(c.y, d.y));
  vec3 col = mix(uTint, vec3(1.0), 0.55 * core);

  // Альфа НОЛЬ — это чистая прибавка света. Пятна под нами формируют альфу
  // слоя, и она решает, где дудлы вообще видны; если бы волна добавляла альфу,
  // она бы на своём пути раскрывала узор сильнее, чем задумано палитрой.
  fragColor = vec4(col * energy, 0.0);
}
