	<!-- Ad attribution via SKAdNetwork: Apple's PRIVACY-PRESERVING install
	     attribution. NO ATT prompt, NO IDFA, NO per-user tracking, and NOT a
	     privacy-label "data collection" item — so it does not compromise the
	     app's privacy positioning. Lets Meta (Facebook/Instagram) attribute iOS
	     installs to campaigns via aggregate SKAN postbacks. These are Meta's two
	     official ad-network IDs (developers.facebook.com/docs/setting-up/
	     platform-setup/ios/SKAdNetwork). X/Twitter routes app-install measurement
	     through an MMP rather than a self-serve SKAN id, so X is measured via UTM
	     store links instead — see docs/ADS_ATTRIBUTION_SETUP.md. -->
	<key>SKAdNetworkItems</key>
	<array>
		<dict>
			<key>SKAdNetworkIdentifier</key>
			<string>v9wttpbfk9.skadnetwork</string>
		</dict>
