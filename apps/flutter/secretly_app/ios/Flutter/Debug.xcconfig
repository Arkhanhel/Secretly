#include? "Pods/Target Support Files/Pods-Runner/Pods-Runner.debug.xcconfig"
#include "Generated.xcconfig"

// Premium alternate app icons (feature #4). Sets live in
// Runner/Assets.xcassets/AltIcon*.appiconset; switched at runtime via the
// `secretly/app_icon` MethodChannel. INCLUDE_ALL bundles every .appiconset
// so UIApplication.setAlternateIconName(...) can resolve them.
ASSETCATALOG_COMPILER_INCLUDE_ALL_APPICON_ASSETS = YES
ASSETCATALOG_COMPILER_ALTERNATE_APPICON_NAMES = AltIconMidnight AltIconOcean AltIconSunset AltIconEmerald AltIconGraphite
