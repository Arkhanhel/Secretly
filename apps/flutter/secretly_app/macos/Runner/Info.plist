<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIconFile</key>
	<string></string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>NSHumanReadableCopyright</key>
	<string>$(PRODUCT_COPYRIGHT)</string>
	<key>NSMainNibFile</key>
	<string>MainMenu</string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>SUFeedURL</key>
	<!-- Свой поддомен на своём сервере — как у Signal (updates.signal.org),
	     Telegram и Element. Проверка обновлений идёт с каждой установленной
	     копии и несёт адрес человека; отдавать этот поток третьей стороне
	     значит сообщать ей, у кого стоит Secretly и когда он включает
	     компьютер. Раздача — блок updates.* в server/proxy/caddy/Caddyfile. -->
	<string>https://updates.secretlyapp.com/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<!-- 🔴 ЭТО ОТКРЫТАЯ ЧАСТЬ КЛЮЧА, И ЕЙ ЗДЕСЬ МЕСТО.
	     Ею приложение ПРОВЕРЯЕТ подпись пакета обновления перед установкой —
	     значит она обязана ехать вместе с приложением. Закрытая часть создана
	     один раз `generate_keys` и живёт в ключнице выпускающего; в дереве
	     исходников её нет и не будет.

	     Менять её нельзя: сборки, уже стоящие у людей, проверяют обновления
	     именно этим ключом. Новый ключ означает, что старые сборки перестанут
	     принимать наши обновления — то есть останутся без них навсегда. -->
	<string>D9ZGqnx7HEv5Qe6TYKXxd/Zf9dxkONCfy8J7rmuz3Ks=</string>
	<key>SUEnableInstallerLauncherService</key>
	<!-- Обновление в песочнице идёт через службу Sparkle внутри рамки;
	     `Downloader.xpc` при этом НЕ нужен — он только для приложений без
	     `network.client`, а оно у нас есть. См. Runner/SparkleBridge.swift. -->
	<true/>
	<key>SUEnableAutomaticChecks</key>
	<!-- 🔴 ПРОВЕРЯЕМ САМИ, НЕ СПРАШИВАЯ РАЗРЕШЕНИЯ ПРОВЕРЯТЬ.
	     Sparkle по умолчанию при первом запуске спрашивает «искать обновления
	     автоматически?». Для мессенджера это неуместный вопрос: человек,
	     ответивший «нет», остаётся на версии с дырой и узнает об этом
	     последним. Сама ПОСТАНОВКА обновления при этом по-прежнему требует
	     его согласия — см. SUAutomaticallyUpdate ниже. -->
	<true/>
	<key>SUScheduledCheckInterval</key>
	<!-- Раз в сутки. Чаще незачем: выпуски не ежечасные, а каждая проверка —
	     это обращение наружу. -->
	<integer>86400</integer>
	<key>SUAutomaticallyUpdate</key>
	<!-- Скачать и поставить молча — НЕТ. Обновление мессенджера меняет
	     программу, которая держит переписку; человек вправе знать, когда это
	     происходит, и доделать начатое. Найдено — показываем, ставим по
	     согласию. -->
	<false/>
	<key>NSMicrophoneUsageDescription</key>
	<string>Secretly использует микрофон для голосовых и видеозвонков, а также для записи голосовых сообщений.</string>
	<key>NSCameraUsageDescription</key>
	<string>Secretly использует камеру для видеозвонков и сканирования QR-кодов привязки устройств.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Secretly использует доступ к фото для отправки изображений в чатах.</string>
	<key>NSDocumentsFolderUsageDescription</key>
	<string>Secretly использует доступ к документам для отправки файлов в чатах.</string>
	<key>NSDownloadsFolderUsageDescription</key>
	<string>Secretly использует доступ к загрузкам для сохранения файлов из чатов.</string>
	<key>NSDesktopFolderUsageDescription</key>
	<string>Secretly использует доступ к рабочему столу для отправки файлов и скриншотов.</string>
	<key>NSAppleEventsUsageDescription</key>
	<string>Secretly использует Apple Events для интеграции с системными уведомлениями.</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.social-networking</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.secretly.deeplink</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>secretly</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
