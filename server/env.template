# Secretly Relay — environment variable template
# Copy to .env and fill in your values.
# Lines starting with # are comments.

# ── ICE / TURN configuration ─────────────────────────────────────────────────
#
# Without a TURN server, calls between devices on DIFFERENT networks (mobile ↔
# Wi-Fi, home ↔ office) will FAIL when both sides are behind symmetric NAT or
# strict firewalls. STUN alone only works when at least one side has a
# permissive NAT (most home routers). For guaranteed cross-network connectivity
# you MUST deploy a coturn server and fill in the variables below.
#
# Quick coturn setup (Ubuntu/Debian):
#   apt install coturn
#   Edit /etc/turnserver.conf:
#     listening-port=3478
#     tls-listening-port=5349
#     fingerprint
#     use-auth-secret
#     static-auth-secret=YOUR_SHARED_SECRET
#     realm=secretly.example.com
#     total-quota=100
#     bps-capacity=0
#     stale-nonce=600
#     no-multicast-peers
#   systemctl enable --now coturn
#
# Then set:
#   SECRETLY_RELAY_ICE_TURN_URLS=turn:your-coturn-host.com:3478,turns:your-coturn-host.com:5349
#   SECRETLY_RELAY_TURN_SHARED_SECRET=YOUR_SHARED_SECRET

# ICE policy: p2p_preferred | relay_preferred | relay_only
# p2p_preferred — try P2P first, fall back to TURN (default, lowest latency)
# relay_preferred — try TURN first (better for strict NAT environments)
# relay_only — always use TURN (highest privacy, requires TURN)
SECRETLY_RELAY_ICE_POLICY=p2p_preferred

# Comma-separated STUN URLs (public Google STUN is used as app-level fallback
# when this is empty, but it's better to run your own)
SECRETLY_RELAY_ICE_STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# Comma-separated TURN/TURNS URLs (required for cross-network calls)
SECRETLY_RELAY_ICE_TURN_URLS=

# coturn REST shared secret for short-lived TURN credentials (required when
# TURN URLs are set)
SECRETLY_RELAY_TURN_SHARED_SECRET=

# TURN credential TTL in seconds (60–3600, default 600)
SECRETLY_RELAY_TURN_TTL_SECONDS=600

# ── Relay core ────────────────────────────────────────────────────────────────
SECRETLY_RELAY_HOST=0.0.0.0
SECRETLY_RELAY_PORT=8080

# Path to the SQLite database file
SECRETLY_RELAY_DB_PATH=./data/relay.sqlite3

# JWT signing key for device tokens (generate with: openssl rand -hex 32)
SECRETLY_RELAY_JWT_SECRET=

# ── Push notification providers ──────────────────────────────────────────────
#
# Without these, the relay accepts and stores push tokens but NEVER dispatches
# a push — incoming calls and messages will not wake closed/locked clients.
# Verify configured state with:
#   curl -s https://<relay-host>/health/push | jq
# All `*_configured` fields must be `true` and `push_ready` must be `true`.
#
# ─── FCM v1 (Android push) ───
# Code reads the file PATH below; it does NOT accept a base64 blob. Generate at:
#   Firebase Console → Project Settings → Service Accounts → Generate new private key
# The downloaded file is named like
#   <project-id>-firebase-adminsdk-XXXXX-YYYYYY.json
# Place it on the relay host (e.g. /etc/secretly/fcm_service_account.json), make
# it readable only by the relay user, and set the absolute path here:
SECRETLY_RELAY_FCM_SERVICE_ACCOUNT_JSON_PATH=

# Legacy FCM server key — deprecated by Google in June 2024; keep empty unless
# you have a legacy server-key fallback. Modern setups should use FCM v1 above.
SECRETLY_RELAY_FCM_SERVER_KEY=

# ─── APNs VoIP (iOS CallKit wake) ───
# All five non-default fields below MUST be set, otherwise apns_voip stays None
# and no iOS push ever fires.
#
# Generate the auth key at:
#   developer.apple.com → Certificates, Identifiers & Profiles → Keys → "+"
#   Enable "Apple Push Notifications service (APNs)" capability.
# Download the .p8 once, store it on the relay host:
#   sudo install -o relay -g relay -m 0400 AuthKey_<KEY_ID>.p8 /etc/secretly/
#
# Apple Developer "Team ID" (10-char alphanumeric, see top-right of developer.apple.com membership page).
SECRETLY_APNS_TEAM_ID=

# Key ID of the .p8 file (same as the filename suffix).
SECRETLY_APNS_KEY_ID=

# Absolute filesystem path to the .p8 file.
SECRETLY_APNS_KEY_PATH=

# iOS app bundle ID (must match CFBundleIdentifier in Runner.app/Info.plist).
SECRETLY_APNS_BUNDLE_ID=com.secretly.messenger

# APNs VoIP topic — by Apple's convention this is `<bundle_id>.voip`. The
# Info.plist of the iOS app declares this as the PushKit topic; mismatching
# values cause every VoIP push to be rejected as BadDeviceToken.
SECRETLY_APNS_VOIP_TOPIC=com.secretly.messenger.voip

# APNs environment: "production" for TestFlight / App Store builds (tokens issued by
# api.push.apple.com), "development" for Xcode debug builds (api.sandbox.push.apple.com).
# **TestFlight tokens are production**; a development setting here returns BadDeviceToken
# for every push silently. Default in code is "development" — set "production" for prod.
SECRETLY_APNS_ENV=production

# When true (default), if the configured env rejects a token with BadDeviceToken,
# the relay retries against the other env once before deleting the token. Leave
# enabled for rollout; tighten only after both prod/sandbox tokens are clean.
SECRETLY_APNS_ENV_FALLBACK=true
